{
	"schemaVersion": 1,
	"id": "invarpaint-stockbook",
	"version": "${version}",
	"name": "Collector's Stockbook",
	"description": "Keep your painting collection neatly packed in a single stack.",
	"authors": [
		"Estecka"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/invariable-paintings-stockbook",
		"sources": "https://github.com/Estecka/mc-invarpaint-stockbook",
		"issues":  "https://github.com/Estecka/mc-invarpaint-stockbook/issues"
	},
	"license": "EUPL",
	"icon": "assets/invarpaint/icon.stockbook.png",
	"environment": "*",
	"custom": {
		"modmenu":{
			"parent": "invarpaint"
		}
	},

	"entrypoints": {
		"main": [
			"tk.estecka.invarpaint.stockbook.InvarpaintStockbookMod"
		],
		"client": [
			"tk.estecka.invarpaint.stockbook.InvarpaintStockbookClient"
		]
	},
	"mixins": [
		"invarpaint-stockbook.mixins.json",
		{ "environment": "client", "config": "invarpaint-stockbook.client.mixins.json" }
	],
	"depends": {
		"invarpaint": "^3.0",
		"minecraft": "^1.21.2",
		"fabricloader": ">=0.16.7",
		"fabric-api": "*",
		"java": ">=21"
	}
}
